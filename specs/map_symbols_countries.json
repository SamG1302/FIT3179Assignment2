{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "MAP IDIOM 2 (proportional symbol): how much each country's warming rate changed between 1950–1979 and 1980–2025 (OWID / ERA5, owid_country_summary.csv). Circle area = size of the change; dark purple = warming sped up, light purple = warming slowed. Purple is used for rates of change only, never for temperature. Click the legend to show one group.",
  "title": {
    "text": "Warming sped up most in Europe and the Middle East",
    "subtitle": [
      "Change in warming rate, 1980–2025 vs 1950–1979, °C per decade",
      "Our World in Data (ERA5) · one circle per country"
    ]
  },
  "width": "container",
  "height": 420,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e6eaec",
        "stroke": null
      }
    },
    {
      "data": {
        "url": "data/ne_110m_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#dcd7cd",
        "stroke": "#f2eee6",
        "strokeWidth": 0.5
      }
    },
    {
      "description": "Country summary joined to point locations (made with mapshaper -points inner)",
      "data": {
        "url": "data/owid_country_summary.csv"
      },
      "transform": [
        {
          "lookup": "map_id",
          "from": {
            "data": {
              "url": "data/country_points.csv"
            },
            "key": "map_id",
            "fields": [
              "lon",
              "lat"
            ]
          }
        },
        {
          "filter": "isValid(datum.lon) && isValid(datum.acceleration)"
        },
        {
          "calculate": "datum.acceleration > 0 ? 'Sped up' : 'Slowed down'",
          "as": "trend"
        },
        {
          "calculate": "abs(datum.acceleration)",
          "as": "size_value"
        }
      ],
      "params": [
        {
          "name": "trend_pick",
          "select": {
            "type": "point",
            "fields": [
              "trend"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "#f2eee6",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "size_value",
          "type": "quantitative",
          "title": "Size of change, °C per decade",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              0.8
            ],
            "range": [
              4,
              420
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "values": [
              0.1,
              0.4,
              0.8
            ],
            "format": ".1f",
            "symbolFillColor": "#8a8494",
            "symbolStrokeColor": "#f2eee6",
            "offset": 16,
            "titlePadding": 6,
            "symbolOffset": 0
          }
        },
        "color": {
          "field": "trend",
          "type": "nominal",
          "title": "Warming has…",
          "scale": {
            "domain": [
              "Sped up",
              "Slowed down"
            ],
            "range": [
              "#5e3c99",
              "#b9a8d9"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "vertical",
            "offset": 16,
            "titlePadding": 6,
            "columns": 1,
            "rowPadding": 6,
            "symbolSize": 110,
            "labelOffset": 6
          }
        },
        "opacity": {
          "condition": {
            "param": "trend_pick",
            "value": 0.72
          },
          "value": 0.06
        },
        "order": {
          "field": "size_value",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "country",
            "title": "Country"
          },
          {
            "field": "rate_early",
            "type": "quantitative",
            "title": "Warming per decade, 1950–1979 (°C)",
            "format": "+.2f"
          },
          {
            "field": "rate_recent",
            "type": "quantitative",
            "title": "Warming per decade, 1980–2025 (°C)",
            "format": "+.2f"
          },
          {
            "field": "acceleration",
            "type": "quantitative",
            "title": "Change in rate (°C per decade)",
            "format": "+.2f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": -22,
            "lat": 42
          }
        ]
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "condition": {
            "test": "width < 700",
            "value": ""
          },
          "value": [
            "Europe and the",
            "Middle East: largest",
            "speed-ups"
          ]
        }
      },
      "description": "Annotation: cluster of large purple circles (halo); sits in the empty North Atlantic beside the cluster, hidden below 700px where it would cover circles",
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "fontSize": 11,
        "fontWeight": 600,
        "lineHeight": 14,
        "stroke": "#f2eee6",
        "strokeWidth": 4,
        "strokeJoin": "round"
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": -22,
            "lat": 42
          }
        ]
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "condition": {
            "test": "width < 700",
            "value": ""
          },
          "value": [
            "Europe and the",
            "Middle East: largest",
            "speed-ups"
          ]
        }
      },
      "description": "Annotation: cluster of large purple circles; sits in the empty North Atlantic beside the cluster, hidden below 700px where it would cover circles",
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "fontSize": 11,
        "fontWeight": 600,
        "lineHeight": 14,
        "color": "#1f2328"
      }
    }
  ],
  "config": {
    "legend": {
      "layout": {
        "bottom": {
          "anchor": "start",
          "direction": "horizontal",
          "margin": 40
        }
      }
    }
  }
}
