{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "MAP IDIOM 1 (choropleth): how much warmer or cooler each country was in a chosen year than its own 1951–1980 average (OWID / Copernicus ERA5, re-baselined in the browser). Year slider 1940–2025. Each country is one national average.",
  "title": {
    "text": "By 2025, every country was warmer than in 1951–1980",
    "subtitle": [
      "Annual average vs that country's 1951–1980 average, °C",
      "Our World in Data (Copernicus ERA5) · grey = no data"
    ]
  },
  "width": "container",
  "height": 420,
  "projection": {
    "type": "equalEarth"
  },
  "params": [
    {
      "name": "year",
      "value": 2025,
      "bind": {
        "input": "range",
        "min": 1940,
        "max": 2025,
        "step": 1,
        "name": "Year "
      }
    }
  ],
  "layer": [
    {
      "description": "Ocean",
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e6eaec",
        "stroke": null
      }
    },
    {
      "description": "All countries in grey, so shapes without data still appear",
      "data": {
        "url": "data/ne_110m_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d3cdc2",
        "stroke": "#f2eee6",
        "strokeWidth": 0.5
      }
    },
    {
      "description": "OWID anomalies joined to Natural Earth shapes on map_id = ADM0_A3",
      "data": {
        "url": "data/owid_annual_countries.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "anomaly": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum.year >= 1951 && datum.year <= 1980 ? datum.anomaly : null",
          "as": "base_value"
        },
        {
          "joinaggregate": [
            {
              "op": "mean",
              "field": "base_value",
              "as": "base_mean"
            }
          ],
          "groupby": [
            "map_id"
          ]
        },
        {
          "calculate": "datum.anomaly - datum.base_mean",
          "as": "anomaly_5180"
        },
        {
          "filter": "datum.year == year"
        },
        {
          "lookup": "map_id",
          "from": {
            "data": {
              "url": "data/ne_110m_countries.topojson",
              "format": {
                "type": "topojson",
                "feature": "ne_110m_admin_0_countries"
              }
            },
            "key": "properties.ADM0_A3"
          },
          "as": "geo"
        },
        {
          "filter": "datum.geo != null"
        },
        {
          "calculate": "datum.geo.properties.NAME",
          "as": "country"
        },
        {
          "calculate": "datum.anomaly_5180 >= 0 ? 'warmer' : 'cooler'",
          "as": "direction"
        }
      ],
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "map_id"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "geoshape"
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "anomaly_5180",
          "type": "quantitative",
          "title": "Warmer (+) or cooler (−) than 1951–1980, °C",
          "scale": {
            "domain": [
              -2,
              -1.333,
              -0.667,
              0,
              1.333,
              2.667,
              4
            ],
            "range": [
              "#2166ac",
              "#67a9cf",
              "#d1e5f0",
              "#ffffff",
              "#fddbc7",
              "#ef8a62",
              "#b2182b"
            ],
            "clamp": true
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 260,
            "format": "+.0f",
            "offset": 16,
            "titlePadding": 6,
            "values": [
              -2,
              0,
              2,
              4
            ]
          }
        },
        "strokeWidth": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1.5
          },
          "value": 0.4
        },
        "stroke": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": "#1f2328"
          },
          "value": "#f2eee6"
        },
        "tooltip": [
          {
            "field": "country",
            "title": "Country"
          },
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "anomaly_5180",
            "type": "quantitative",
            "title": "Difference from its 1951–1980 average (°C)",
            "format": "+.2f"
          }
        ]
      }
    }
  ]
}
