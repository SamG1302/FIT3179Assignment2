{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "MAP IDIOM 3 (bin map): for each 5° x 5° grid cell (Berkeley Earth, land and ocean), the decade from which every decade has averaged at least +1°C above the cell's 1951–1980 average. 'Stayed above' rather than 'first reached' so that one-off warm spells (e.g. the 1930s Arctic) do not count. Squares come from be_grid_cells.geojson; the decade comes from be_grid_first_1c.csv (prep_data.R, section 10), joined on id. Click a legend entry to show one group.",
  "title": {
    "text": "The Arctic passed +1°C first; much of the ocean has not",
    "subtitle": [
      "Decade from which it has stayed 1°C or more above",
      "its 1951–1980 average · Berkeley Earth 5° grid",
      "Land and ocean · 2020s = 2020–2025"
    ]
  },
  "width": "container",
  "height": 420,
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "description": "Grey globe = cells with no data",
      "data": {
        "sphere": true
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d3cdc2",
        "stroke": null
      }
    },
    {
      "description": "One square per 5° cell, coloured by the decade it passed +1°C for good",
      "data": {
        "url": "data/be_grid_cells.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "lookup": "properties.id",
          "from": {
            "data": {
              "url": "data/be_grid_first_1c.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "id": "number",
                  "stayed_from": "number",
                  "latest": "number"
                }
              }
            },
            "key": "id",
            "fields": [
              "stayed_from",
              "latest"
            ]
          }
        },
        {
          "calculate": "datum.stayed_from >= 1900 ? (datum.stayed_from < 2000 ? 'Before 2000' : datum.stayed_from == 2020 ? '2020–2025' : datum.stayed_from + 's') : 'Not yet'",
          "as": "period"
        },
        {
          "calculate": "datum.properties.land >= 0.5 ? 'Mostly land' : 'Mostly ocean'",
          "as": "surface"
        }
      ],
      "params": [
        {
          "name": "pick",
          "select": {
            "type": "point",
            "fields": [
              "period"
            ]
          },
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#f2eee6",
        "strokeWidth": 0.25
      },
      "encoding": {
        "color": {
          "field": "period",
          "type": "ordinal",
          "title": "Above +1°C for good since…",
          "scale": {
            "domain": [
              "Before 2000",
              "2000s",
              "2010s",
              "2020–2025",
              "Not yet"
            ],
            "range": [
              "#0a4f3c",
              "#228058",
              "#55b07a",
              "#a9dcb3",
              "#ffffff"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "square",
            "symbolSize": 140,
            "symbolStrokeColor": "#9a968e",
            "symbolStrokeWidth": 0.5,
            "columnPadding": 14,
            "offset": 16,
            "titlePadding": 6,
            "columns": 3
          }
        },
        "opacity": {
          "condition": {
            "param": "pick",
            "value": 1
          },
          "value": 0.15
        },
        "tooltip": [
          {
            "field": "surface",
            "title": "Grid square"
          },
          {
            "field": "period",
            "title": "Above +1°C for good since"
          },
          {
            "field": "latest",
            "type": "quantitative",
            "title": "2020–2025 average vs 1951–1980 (°C)",
            "format": "+.2f"
          }
        ]
      }
    },
    {
      "description": "Coastlines on top for orientation",
      "data": {
        "url": "data/land-110m.json",
        "format": {
          "type": "topojson",
          "feature": "land"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#1f2328",
        "strokeWidth": 0.6,
        "strokeOpacity": 0.55
      }
    },
    {
      "description": "Annotation: earliest region (halo); placed in the empty corner beside the map so it covers no squares; hidden below 880px",
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "fontSize": 11,
        "fontWeight": 600,
        "lineHeight": 14,
        "stroke": "#f2eee6",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "text": {
          "condition": {
            "test": "width < 880",
            "value": ""
          },
          "value": [
            "Arctic: above +1°C",
            "since the 1990s or 2000s"
          ]
        },
        "x": {
          "value": {
            "expr": "width"
          }
        },
        "y": {
          "value": 0
        }
      },
      "data": {
        "values": [
          {}
        ]
      }
    },
    {
      "description": "Annotation: earliest region; placed in the empty corner beside the map so it covers no squares; hidden below 880px",
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "fontSize": 11,
        "fontWeight": 600,
        "lineHeight": 14,
        "color": "#1f2328"
      },
      "encoding": {
        "text": {
          "condition": {
            "test": "width < 880",
            "value": ""
          },
          "value": [
            "Arctic: above +1°C",
            "since the 1990s or 2000s"
          ]
        },
        "x": {
          "value": {
            "expr": "width"
          }
        },
        "y": {
          "value": 0
        }
      },
      "data": {
        "values": [
          {}
        ]
      }
    },
    {
      "description": "Annotation: largest 'not yet' area (halo); hidden on narrow screens, where it would cover the map",
      "data": {
        "values": [
          {
            "lon": -150,
            "lat": -8
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 11,
        "fontWeight": 600,
        "lineHeight": 14,
        "stroke": "#f2eee6",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "condition": {
            "test": "width < 760",
            "value": ""
          },
          "value": [
            "Eastern tropical Pacific:",
            "not there yet"
          ]
        }
      }
    },
    {
      "description": "Annotation: largest 'not yet' area; hidden on narrow screens, where it would cover the map",
      "data": {
        "values": [
          {
            "lon": -150,
            "lat": -8
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 11,
        "fontWeight": 600,
        "lineHeight": 14,
        "color": "#1f2328"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "condition": {
            "test": "width < 760",
            "value": ""
          },
          "value": [
            "Eastern tropical Pacific:",
            "not there yet"
          ]
        }
      }
    },
    {
      "description": "Annotation: Australia (halo); placed in the empty corner beside the map so it covers no squares; hidden below 880px",
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "fontSize": 11,
        "fontWeight": 600,
        "lineHeight": 14,
        "stroke": "#f2eee6",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "text": {
          "condition": {
            "test": "width < 880",
            "value": ""
          },
          "value": [
            "Australia: 11 of 27 land",
            "squares, mostly since 2020"
          ]
        },
        "x": {
          "value": {
            "expr": "width"
          }
        },
        "y": {
          "value": {
            "expr": "height"
          }
        }
      },
      "data": {
        "values": [
          {}
        ]
      }
    },
    {
      "description": "Annotation: Australia; placed in the empty corner beside the map so it covers no squares; hidden below 880px",
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "fontSize": 11,
        "fontWeight": 600,
        "lineHeight": 14,
        "color": "#1f2328"
      },
      "encoding": {
        "text": {
          "condition": {
            "test": "width < 880",
            "value": ""
          },
          "value": [
            "Australia: 11 of 27 land",
            "squares, mostly since 2020"
          ]
        },
        "x": {
          "value": {
            "expr": "width"
          }
        },
        "y": {
          "value": {
            "expr": "height"
          }
        }
      },
      "data": {
        "values": [
          {}
        ]
      }
    }
  ]
}
