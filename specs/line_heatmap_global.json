{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Overview + detail (NASA GISTEMP v4). Top: global annual anomaly with the trailing 10-year mean; drag across it to brush a period. Bottom: month x year heatmap that zooms to the brushed years. Both views are in one spec so the brush can link them.",
  "usermeta": {
    "responsive": {
      "layout": "vconcat",
      "reserve": 84
    }
  },
  "title": {
    "text": "Global temperature anomaly, 1880–2025",
    "subtitle": [
      "Difference from the 1951–1980 average, °C · NASA GISTEMP v4",
      "Drag across the line chart to zoom the heatmap below"
    ]
  },
  "spacing": 28,
  "vconcat": [
    {
      "width": 900,
      "height": 260,
      "data": {
        "url": "data/gistemp_global.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "annual": "number",
            "mean_10yr": "number",
            "vs_1880_1900": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.annual)"
        }
      ],
      "layer": [
        {
          "description": "Zero line = the 1951–1980 average",
          "mark": {
            "type": "rule",
            "color": "#9a968e",
            "strokeDash": [
              4,
              3
            ]
          },
          "encoding": {
            "y": {
              "datum": 0,
              "type": "quantitative"
            }
          }
        },
        {
          "description": "Annotation: from 1977 every year is above the 1951–1980 average",
          "mark": {
            "type": "rule",
            "color": "#5c6370",
            "strokeDash": [
              2,
              3
            ]
          },
          "encoding": {
            "x": {
              "datum": 1977,
              "type": "quantitative",
              "scale": {
                "domain": [
                  1880,
                  2026
                ],
                "nice": false
              }
            }
          },
          "data": {
            "values": [
              {}
            ]
          }
        },
        {
          "description": "Annotation text for the 1977 line (white halo behind the text)",
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "top",
            "dx": -6,
            "fontSize": 11,
            "color": "#5c6370",
            "lineHeight": 14,
            "stroke": "#f2eee6",
            "strokeWidth": 4,
            "strokeJoin": "round"
          },
          "encoding": {
            "x": {
              "datum": 1977,
              "type": "quantitative",
              "scale": {
                "domain": [
                  1880,
                  2026
                ],
                "nice": false
              }
            },
            "y": {
              "datum": 1.3,
              "type": "quantitative"
            },
            "text": {
              "value": [
                "From 1977, every year is",
                "above the 1951–1980 average"
              ]
            }
          },
          "data": {
            "values": [
              {}
            ]
          }
        },
        {
          "description": "Annotation text for the 1977 line",
          "mark": {
            "type": "text",
            "align": "right",
            "baseline": "top",
            "dx": -6,
            "fontSize": 11,
            "color": "#5c6370",
            "lineHeight": 14
          },
          "encoding": {
            "x": {
              "datum": 1977,
              "type": "quantitative",
              "scale": {
                "domain": [
                  1880,
                  2026
                ],
                "nice": false
              }
            },
            "y": {
              "datum": 1.3,
              "type": "quantitative"
            },
            "text": {
              "value": [
                "From 1977, every year is",
                "above the 1951–1980 average"
              ]
            }
          },
          "data": {
            "values": [
              {}
            ]
          }
        },
        {
          "description": "Annotation: the record year (white halo behind the text)",
          "transform": [
            {
              "filter": "datum.year == 2024"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -8,
            "dy": 2,
            "fontSize": 11,
            "fontWeight": 600,
            "color": "#1f2328",
            "stroke": "#f2eee6",
            "strokeWidth": 4,
            "strokeJoin": "round"
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative"
            },
            "y": {
              "field": "annual",
              "type": "quantitative"
            },
            "text": {
              "value": "2024: +1.28°C, the warmest year"
            }
          }
        },
        {
          "description": "Annotation: the record year",
          "transform": [
            {
              "filter": "datum.year == 2024"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -8,
            "dy": 2,
            "fontSize": 11,
            "fontWeight": 600,
            "color": "#1f2328"
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative"
            },
            "y": {
              "field": "annual",
              "type": "quantitative"
            },
            "text": {
              "value": "2024: +1.28°C, the warmest year"
            }
          }
        },
        {
          "description": "Annual values (muted) + the brush that drives the heatmap",
          "params": [
            {
              "name": "brush",
              "select": {
                "type": "interval",
                "encodings": [
                  "x"
                ]
              }
            }
          ],
          "mark": {
            "type": "line",
            "color": "#b5afa5",
            "strokeWidth": 1.5
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative",
              "title": "Year",
              "axis": {
                "format": "d",
                "grid": false,
                "tickCount": 10
              },
              "scale": {
                "domain": [
                  1880,
                  2026
                ],
                "nice": false
              }
            },
            "y": {
              "field": "annual",
              "type": "quantitative",
              "title": "Anomaly (°C)",
              "axis": {
                "format": "+.1f",
                "minExtent": 52
              }
            }
          }
        },
        {
          "description": "Trailing 10-year mean: the main story line",
          "transform": [
            {
              "filter": "isValid(datum.mean_10yr)"
            }
          ],
          "mark": {
            "type": "line",
            "color": "#1f2328",
            "strokeWidth": 2.5
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative"
            },
            "y": {
              "field": "mean_10yr",
              "type": "quantitative"
            }
          }
        },
        {
          "description": "Hover: nearest year carries the tooltip",
          "params": [
            {
              "name": "hover",
              "select": {
                "type": "point",
                "fields": [
                  "year"
                ],
                "nearest": true,
                "on": "pointerover",
                "clear": "pointerout"
              }
            }
          ],
          "mark": {
            "type": "point",
            "size": 60,
            "filled": true,
            "color": "#1f2328"
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative"
            },
            "y": {
              "field": "annual",
              "type": "quantitative"
            },
            "opacity": {
              "condition": {
                "param": "hover",
                "empty": false,
                "value": 1
              },
              "value": 0
            },
            "tooltip": [
              {
                "field": "year",
                "type": "quantitative",
                "title": "Year",
                "format": "d"
              },
              {
                "field": "annual",
                "type": "quantitative",
                "title": "Difference from 1951–1980 (°C)",
                "format": "+.2f"
              },
              {
                "field": "mean_10yr",
                "type": "quantitative",
                "title": "Average of previous 10 years (°C)",
                "format": "+.2f"
              },
              {
                "field": "vs_1880_1900",
                "type": "quantitative",
                "title": "Difference from 1880–1900 (°C)",
                "format": "+.2f"
              }
            ]
          }
        },
        {
          "description": "Mini legend in the empty top-left corner (replaces a label that collided with the line): red line",
          "data": {
            "values": [
              {}
            ]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "fontSize": 11,
            "fontWeight": 600,
            "color": "#1f2328"
          },
          "encoding": {
            "x": {
              "datum": 1883,
              "type": "quantitative",
              "scale": {
                "domain": [
                  1880,
                  2026
                ],
                "nice": false
              }
            },
            "y": {
              "datum": 1.3,
              "type": "quantitative"
            },
            "text": {
              "value": "10-year average"
            }
          }
        },
        {
          "description": "Mini legend: grey line",
          "data": {
            "values": [
              {}
            ]
          },
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "fontSize": 11,
            "fontWeight": 400,
            "color": "#5c6370"
          },
          "encoding": {
            "x": {
              "datum": 1883,
              "type": "quantitative",
              "scale": {
                "domain": [
                  1880,
                  2026
                ],
                "nice": false
              }
            },
            "y": {
              "datum": 1.13,
              "type": "quantitative"
            },
            "text": {
              "value": "Single year"
            }
          }
        }
      ]
    },
    {
      "width": 900,
      "height": 190,
      "data": {
        "url": "data/gistemp_monthly.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "month": "number",
            "anomaly": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year <= 2025"
        },
        {
          "calculate": "datum.year + 1",
          "as": "year_end"
        }
      ],
      "mark": {
        "type": "rect",
        "clip": true
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": "Year",
          "scale": {
            "domain": {
              "param": "brush"
            },
            "nice": false
          },
          "axis": {
            "format": "d",
            "grid": false,
            "tickCount": 10
          }
        },
        "x2": {
          "field": "year_end"
        },
        "y": {
          "field": "month_name",
          "type": "ordinal",
          "title": "Month",
          "sort": [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun",
            "Jul",
            "Aug",
            "Sep",
            "Oct",
            "Nov",
            "Dec"
          ],
          "axis": {
            "minExtent": 52,
            "ticks": false,
            "domain": false,
            "labelExpr": "indexof(['Jan','Apr','Jul','Oct'], datum.value) >= 0 ? datum.value : ''"
          }
        },
        "color": {
          "field": "anomaly",
          "type": "quantitative",
          "title": "Monthly difference from 1951–1980, °C",
          "scale": {
            "domain": [
              -1.5,
              -1.0,
              -0.5,
              0,
              0.5,
              1.0,
              1.5
            ],
            "range": [
              "#2166ac",
              "#67a9cf",
              "#d1e5f0",
              "#ffffff",
              "#fddbc7",
              "#ef8a62",
              "#b2182b"
            ],
            "clamp": true
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 260,
            "format": "+.1f",
            "values": [
              -1.5,
              -0.75,
              0,
              0.75,
              1.5
            ]
          }
        },
        "tooltip": [
          {
            "field": "month_name",
            "title": "Month"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "anomaly",
            "type": "quantitative",
            "title": "Anomaly (°C)",
            "format": "+.2f"
          }
        ]
      },
      "description": "Month x year heatmap (complete years 1880–2025, so its x range matches the line chart above)"
    }
  ]
}
