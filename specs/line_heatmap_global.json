{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Overview + detail (NASA GISTEMP v4). Top: global annual anomaly with the trailing 10-year mean; drag across it to brush a period. Bottom: month x year heatmap that zooms to the brushed years. Both views are in one spec so the brush can link them. Numbers in square brackets in the notes refer to the References list in the page footer.",
  "usermeta": {
    "responsive": {
      "layout": "vconcat",
      "reserve": 84,
      "hideBelow": 760,
      "hideLayers": [
        "Annotation",
        "Note",
        "Leader",
        "Bracket",
        "Event markers"
      ]
    }
  },
  "title": {
    "text": "Warming took off after the 1970s",
    "subtitle": [
      "Global temperature, difference from the 1951–1980 average, °C",
      "NASA GISTEMP v4"
    ]
  },
  "spacing": 28,
  "vconcat": [
    {
      "width": 900,
      "height": 260,
      "data": {
        "url": "data/gistemp_global.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "annual": "number",
            "mean_10yr": "number",
            "vs_1880_1900": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.annual)"
        }
      ],
      "layer": [
        {
          "description": "Zero line = the 1951–1980 average",
          "mark": {
            "type": "rule",
            "color": "#9a968e",
            "strokeDash": [
              4,
              3
            ]
          },
          "encoding": {
            "y": {
              "datum": 0,
              "type": "quantitative"
            }
          }
        },
        {
          "description": "Annotation: label for the dashed zero line (halo)",
          "mark": {
            "type": "text",
            "fontSize": 11,
            "color": "#5c6370",
            "align": "right",
            "baseline": "top",
            "dy": 7,
            "stroke": "#f2eee6",
            "strokeWidth": 4,
            "strokeJoin": "round"
          },
          "encoding": {
            "x": {
              "datum": 2024,
              "type": "quantitative",
              "scale": {
                "domain": [
                  1880,
                  2026
                ],
                "nice": false
              }
            },
            "y": {
              "datum": 0,
              "type": "quantitative"
            },
            "text": {
              "value": "Dashed line: 1951–1980 average"
            }
          },
          "data": {
            "values": [
              {}
            ]
          }
        },
        {
