            },
            "nice": false
          },
          "axis": {
            "format": "d",
            "grid": false,
            "tickCount": 10
          }
        },
        "x2": {
          "field": "year_end"
        },
        "y": {
          "field": "month_name",
          "type": "ordinal",
          "title": "Month",
          "sort": [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun",
            "Jul",
            "Aug",
            "Sep",
            "Oct",
            "Nov",
            "Dec"
          ],
          "axis": {
            "minExtent": 52,
            "ticks": false,
            "domain": false,
