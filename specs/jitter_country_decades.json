{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Jitter plot: every country's decade-average anomaly (OWID / ERA5, re-baselined to each country's 1951–1980 mean), one dot per country per decade. Dots are spread sideways by a fixed pseudo-random offset (stable between page loads). Black dashes = median country. The dropdown highlights one country's path; Australia by default. A small key in the empty top-left corner explains each mark in plain words (each key layer filters the main data down to one row, because the top-level transforms also apply to layers), so no statistics knowledge is needed.",
  "title": {
    "text": "Every country, decade by decade",
    "subtitle": [
      "Each country's decade average compared with its own 1951–1980 average, °C",
      "Our World in Data (ERA5)"
    ]
  },
  "width": "container",
  "height": 360,
  "params": [
    {
      "name": "focus",
      "value": "AUS",
      "bind": {
        "input": "select",
        "name": "Highlight ",
        "options": [
          "AUS",
          "MYS",
          "NZL",
          "IDN",
          "PNG",
          "CHN",
          "IND",
          "JPN",
          "RUS",
          "NOR",
          "DEU",
          "GBR",
          "EGY",
          "SAU",
          "ZAF",
          "USA",
          "CAN",
          "BRA",
          "ARG"
        ],
        "labels": [
          "Australia",
          "Malaysia",
          "New Zealand",
          "Indonesia",
          "Papua New Guinea",
          "China",
          "India",
          "Japan",
          "Russia",
          "Norway",
          "Germany",
          "United Kingdom",
          "Egypt",
          "Saudi Arabia",
          "South Africa",
          "United States",
          "Canada",
          "Brazil",
          "Argentina"
        ]
      }
    }
  ],
  "data": {
    "url": "data/owid_annual_countries.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "anomaly": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.year >= 1951 && datum.year <= 1980 ? datum.anomaly : null",
      "as": "base_value"
    },
    {
      "joinaggregate": [
        {
          "op": "mean",
          "field": "base_value",
          "as": "base_mean"
        }
      ],
      "groupby": [
        "map_id"
      ]
    },
    {
      "calculate": "datum.anomaly - datum.base_mean",
      "as": "anom"
    },
    {
      "calculate": "floor(datum.year / 10) * 10",
      "as": "decade"
    },
    {
      "aggregate": [
        {
          "op": "mean",
          "field": "anom",
          "as": "anomaly"
        }
      ],
      "groupby": [
        "map_id",
        "decade"
      ]
    },
    {
      "lookup": "map_id",
      "from": {
        "data": {
          "url": "data/owid_country_summary.csv"
        },
        "key": "map_id",
        "fields": [
          "country"
        ]
      }
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "row"
        }
      ],
      "groupby": [
        "decade"
      ],
      "sort": [
        {
          "field": "map_id"
        }
      ]
    },
    {
      "calculate": "((datum.row * 7919) % 97) / 97",
      "as": "jitter"
    },
    {
      "calculate": "datum.decade + 1 + datum.jitter * 8",
      "as": "x_pos"
    },
    {
      "calculate": "datum.decade == 2020 ? '2020–2025' : datum.decade + 's'",
      "as": "decade_label"
    }
  ],
  "encoding": {
    "x": {
      "field": "x_pos",
      "type": "quantitative",
      "title": "Decade",
      "scale": {
        "domain": [
          1940,
          2030
        ],
        "nice": false
      },
      "axis": {
        "values": [
          1945,
          1955,
          1965,
          1975,
          1985,
          1995,
          2005,
          2015,
          2025
        ],
        "labelExpr": "(datum.value - 5) + 's'",
        "grid": false,
        "ticks": false
      }
    },
    "y": {
      "field": "anomaly",
      "type": "quantitative",
      "title": "Warmer (+) or cooler (−) than 1951–1980 (°C)",
      "axis": {
        "format": "+.1f"
      }
    }
  },
  "layer": [
    {
      "description": "Zero line = 1951–1980 average",
      "mark": {
        "type": "rule",
        "color": "#9a968e",
        "strokeDash": [
          4,
          3
        ]
      },
      "encoding": {
        "x": null,
        "y": {
          "datum": 0,
          "type": "quantitative"
        }
      }
    },
    {
      "description": "All countries: small muted dots",
      "mark": {
        "type": "circle",
        "size": 22,
        "color": "#b5afa5",
        "opacity": 0.55
      },
      "encoding": {
        "tooltip": [
          {
            "field": "country",
            "title": "Country"
          },
          {
            "field": "decade_label",
            "title": "Decade"
          },
          {
            "field": "anomaly",
            "type": "quantitative",
            "title": "Anomaly (°C)",
            "format": "+.2f"
          }
        ]
      }
    },
    {
      "description": "Median country per decade",
      "transform": [
        {
          "aggregate": [
            {
              "op": "median",
              "field": "anomaly",
              "as": "median"
            }
          ],
          "groupby": [
            "decade"
          ]
        },
        {
          "calculate": "datum.decade + 1",
          "as": "x0"
        },
        {
          "calculate": "datum.decade + 9",
          "as": "x1"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#5c6370",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative"
        },
        "x2": {
          "field": "x1"
        },
        "y": {
          "field": "median",
          "type": "quantitative"
        }
      }
    },
    {
      "description": "Highlighted country: its path across decades",
      "transform": [
        {
          "filter": "datum.map_id == focus"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#1f2328",
        "strokeWidth": 1.5,
        "opacity": 0.8
      }
    },
    {
      "description": "Highlighted country: dots",
      "transform": [
        {
          "filter": "datum.map_id == focus"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 90,
        "color": "#1f2328",
        "opacity": 1,
        "stroke": "#f2eee6",
        "strokeWidth": 1.5
      },
      "encoding": {
        "tooltip": [
          {
            "field": "country",
            "title": "Country"
          },
          {
            "field": "decade_label",
            "title": "Decade"
          },
          {
            "field": "anomaly",
            "type": "quantitative",
            "title": "Anomaly (°C)",
            "format": "+.2f"
          }
        ]
      }
    },
    {
      "description": "Label the highlighted country at its latest dot (white halo)",
      "transform": [
        {
          "filter": "datum.map_id == focus && datum.decade == 2020"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "dy": -10,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#1f2328",
        "stroke": "#f2eee6",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "text": {
          "field": "country"
        }
      }
    },
    {
      "description": "Label the highlighted country at its latest dot",
      "transform": [
        {
          "filter": "datum.map_id == focus && datum.decade == 2020"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "dy": -10,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#1f2328"
      },
      "encoding": {
        "text": {
          "field": "country"
        }
      }
    },
    {
      "description": "Annotation: warmest country in the 2020s (maximum value)",
      "transform": [
        {
          "filter": "datum.decade == 2020"
        },
        {
          "window": [
            {
              "op": "rank",
              "as": "r"
            }
          ],
          "sort": [
            {
              "field": "anomaly",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.r == 1"
        },
        {
          "calculate": "'Warmest: ' + datum.country + ' ' + format(datum.anomaly, '+.1f') + '°C'",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "fontSize": 10,
        "color": "#5c6370"
      },
      "encoding": {
        "text": {
          "field": "lab"
        }
      }
    },
    {
      "description": "Key: grey dot sample",
      "mark": {
        "type": "circle",
        "size": 40,
        "color": "#b5afa5",
        "opacity": 0.9
      },
      "encoding": {
        "x": {
          "datum": 1943,
          "type": "quantitative"
        },
        "y": {
          "datum": 2.85,
          "type": "quantitative"
        }
      },
      "transform": [
        {
          "filter": "datum.decade == 1940 && datum.row == 1"
        }
      ]
    },
    {
      "description": "Key: median dash sample",
      "mark": {
        "type": "rule",
        "color": "#5c6370",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "datum": 1941.3,
          "type": "quantitative"
        },
        "x2": {
          "datum": 1944.7
        },
        "y": {
          "datum": 2.6,
          "type": "quantitative"
        }
      },
      "transform": [
        {
          "filter": "datum.decade == 1940 && datum.row == 1"
        }
      ]
    },
    {
      "description": "Key: highlighted country sample",
      "mark": {
        "type": "circle",
        "size": 80,
        "color": "#1f2328",
        "opacity": 1
      },
      "encoding": {
        "x": {
          "datum": 1943,
          "type": "quantitative"
        },
        "y": {
          "datum": 2.35,
          "type": "quantitative"
        }
      },
      "transform": [
        {
          "filter": "datum.decade == 1940 && datum.row == 1"
        }
      ]
    },
    {
      "description": "Key text: One country, one decade",
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 11,
        "color": "#1f2328",
        "fontWeight": 400
      },
      "encoding": {
        "x": {
          "datum": 1946.5,
          "type": "quantitative"
        },
        "y": {
          "datum": 2.85,
          "type": "quantitative"
        },
        "text": {
          "condition": {
            "test": "width < 260",
            "value": ""
          },
          "value": "One country, one decade"
        }
      },
      "transform": [
        {
          "filter": "datum.decade == 1940 && datum.row == 1"
        }
      ]
    },
    {
      "description": "Key text: Middle country: half are above it",
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 11,
        "color": "#1f2328",
        "fontWeight": 400
      },
      "encoding": {
        "x": {
          "datum": 1946.5,
          "type": "quantitative"
        },
        "y": {
          "datum": 2.6,
          "type": "quantitative"
        },
        "text": {
          "condition": {
            "test": "width < 260",
            "value": ""
          },
          "value": "Middle country: half are above it"
        }
      },
      "transform": [
        {
          "filter": "datum.decade == 1940 && datum.row == 1"
        }
      ]
    },
    {
      "description": "Key text: Country chosen in the list below",
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 11,
        "color": "#1f2328",
        "fontWeight": 400
      },
      "encoding": {
        "x": {
          "datum": 1946.5,
          "type": "quantitative"
        },
        "y": {
          "datum": 2.35,
          "type": "quantitative"
        },
        "text": {
          "condition": {
            "test": "width < 260",
            "value": ""
          },
          "value": "Country chosen in the list below"
        }
      },
      "transform": [
        {
          "filter": "datum.decade == 1940 && datum.row == 1"
        }
      ]
    },
    {
      "description": "Key text: Spread sideways only to avoid overlap",
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 11,
        "color": "#5c6370",
        "fontWeight": 400,
        "lineHeight": 14
      },
      "encoding": {
        "x": {
          "datum": 1946.5,
          "type": "quantitative"
        },
        "y": {
          "datum": 1.92,
          "type": "quantitative"
        },
        "text": {
          "condition": {
            "test": "width < 260",
            "value": ""
          },
          "value": [
            "Dots spread sideways only",
            "so they don't overlap"
          ]
        }
      },
      "transform": [
        {
          "filter": "datum.decade == 1940 && datum.row == 1"
        }
      ]
    },
    {
      "description": "Annotation: what the shift means, using the 2020s median (computed)",
      "transform": [
        {
          "filter": "datum.decade == 2020"
        },
        {
          "joinaggregate": [
            {
              "op": "median",
              "field": "anomaly",
              "as": "m"
            }
          ]
        },
        {
          "filter": "datum.row == 1"
        },
        {
          "calculate": "['The whole cloud has moved up: in', 'the 2020s the middle country is ' + format(datum.m, '+.1f') + '°C']",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "fontSize": 11,
        "color": "#1f2328",
        "lineHeight": 14
      },
      "encoding": {
        "x": {
          "datum": 2029,
          "type": "quantitative"
        },
        "y": {
          "datum": -0.45,
          "type": "quantitative"
        },
        "text": {
          "condition": {
            "test": "width < 300",
            "value": ""
          },
          "field": "lab"
        }
      }
    },
    {
      "description": "Key: dashed zero line sample",
      "transform": [
        {
          "filter": "datum.decade == 1940 && datum.row == 1"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#9a968e",
        "strokeDash": [
          4,
          3
        ],
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "datum": 1941.3,
          "type": "quantitative"
        },
        "x2": {
          "datum": 1944.7
        },
        "y": {
          "datum": 2.1,
          "type": "quantitative"
        }
      }
    },
    {
      "description": "Key text: dashed line",
      "transform": [
        {
          "filter": "datum.decade == 1940 && datum.row == 1"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "fontSize": 11,
        "color": "#1f2328"
      },
      "encoding": {
        "x": {
          "datum": 1946.5,
          "type": "quantitative"
        },
        "y": {
          "datum": 2.1,
          "type": "quantitative"
        },
        "text": {
          "condition": {
            "test": "width < 260",
            "value": ""
          },
          "value": "No change from 1951–1980"
        }
      }
    }
  ]
}
