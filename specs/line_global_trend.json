{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Global annual mean land + ocean temperature anomaly (NASA GISTEMP v4), with the trailing 10-year mean from prep_data.R.",
  "title": {
    "text": "Global temperature anomaly, 1880–2025",
    "subtitle": ["Difference from the 1951–1980 average, °C", "NASA GISTEMP v4"]
  },
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/gistemp_global.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "annual": "number",
        "mean_10yr": "number",
        "vs_1880_1900": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "isValid(datum.annual)"
    }
  ],
  "layer": [
    {
      "description": "Zero line = the 1951–1980 average",
      "mark": {
        "type": "rule",
        "color": "#9a968e",
        "strokeDash": [
          4,
          3
        ]
      },
      "encoding": {
        "y": {
          "datum": 0,
          "type": "quantitative"
        }
      }
    },
    {
      "description": "Annual values: thin and muted so the trend line stands out",
      "mark": {
        "type": "line",
        "color": "#b9b6af",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "axis": {
            "format": "d",
            "grid": false,
            "tickCount": 10
          },
          "scale": {
            "zero": false,
            "nice": false
          }
        },
        "y": {
          "field": "annual",
          "type": "quantitative",
          "title": "Anomaly (°C)",
          "axis": {
            "format": "+.1f"
          }
        }
      }
    },
    {
      "description": "Trailing 10-year mean (mean_10yr): the main story line",
      "mark": {
        "type": "line",
        "color": "#b2182b",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "y": {
          "field": "mean_10yr",
          "type": "quantitative"
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.mean_10yr)"
        }
      ]
    },
    {
      "description": "Direct label on the trend line instead of a legend",
      "transform": [
        {
          "filter": "isValid(datum.mean_10yr)"
        },
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "year",
              "as": "last_year"
            }
          ]
        },
        {
          "filter": "datum.year === datum.last_year"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -4,
        "dy": 16,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#b2182b"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "y": {
          "field": "mean_10yr",
          "type": "quantitative"
        },
        "text": {
          "value": "10-year average"
        }
      }
    },
    {
      "description": "Hover: invisible points pick the nearest year and carry the tooltip",
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "year"
            ],
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "size": 60,
        "filled": true,
        "color": "#1f2328"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "y": {
          "field": "annual",
          "type": "quantitative"
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "annual",
            "type": "quantitative",
            "title": "Anomaly (°C)",
            "format": "+.2f"
          },
          {
            "field": "mean_10yr",
            "type": "quantitative",
            "title": "10-yr average (°C)",
            "format": "+.2f"
          },
          {
            "field": "vs_1880_1900",
            "type": "quantitative",
            "title": "vs 1880–1900 (°C)",
            "format": "+.2f"
          }
        ]
      }
    },
    {
      "description": "Hover: vertical crosshair at the selected year",
      "mark": {
        "type": "rule",
        "color": "#1f2328",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative"
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 0.4
          },
          "value": 0
        }
      }
    }
  ]
}
